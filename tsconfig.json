{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "lib": ["ES2018"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}